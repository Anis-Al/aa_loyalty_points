<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="loyalty.mail_template_loyalty_card" model="mail.template">
        <field name="body_html" type="html">
<table border="0" cellpadding="0" cellspacing="0" style="width:100%; margin:0px auto; background:#ffffff; color:#333333;"><tbody>
<tr>
    <td valign="top" style="font-size: 14px;">
        Hello <t t-out="object._mail_get_customer().name or ''">Brandon Freeman</t>,<br/><br/>

        Thank you for your loyalty.<br/><br/>

        <t t-if="object._shows_points_statement()">
            Your current balance:
            <strong t-out="object.points_display or ''">100 Points</strong><br/>
        </t>
        Your card code:
        <strong style="padding: 4px 8px; border-radius: 3px; background-color: #F1F1F1;" t-out="object.code or ''">15637502648479132902</strong><br/>
        <t t-if="object.expiration_date">
            Valid until: <t t-out="format_date(object.expiration_date) or ''">2026-12-31</t><br/>
        </t>
        <br/>

        Your points can be used on your next order, in store and online.<br/><br/>

        See you soon,<br/>
        The <t t-out="object.company_id.name or ''">YourCompany</t> team
        <t t-if="object._get_signature()">
            <div>--<br/><t t-out="object._get_signature() or ''">Mitchell Admin</t></div>
        </t>
    </td>
</tr>
</tbody></table>
        </field>
    </record>

</odoo>
