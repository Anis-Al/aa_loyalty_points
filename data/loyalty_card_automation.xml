<odoo>

    <record id="loyalty_card_expiry_rule" model="base.automation">
        <field name="name">Discount code: expires 12 months after creation</field>
        <field name="model_id" ref="loyalty.model_loyalty_card"/>
        <field name="trigger">on_create</field>
        <field name="filter_domain">[("program_id.program_type", "=", "next_order_coupons"), ("expiration_date", "=", False)]</field>
    </record>

    <record id="loyalty_card_expiry_action" model="ir.actions.server">
        <field name="name">Set the expiration date 12 months after creation</field>
        <field name="base_automation_id" ref="loyalty_card_expiry_rule"/>
        <field name="usage">base_automation</field>
        <field name="model_id" ref="loyalty.model_loyalty_card"/>
        <field name="state">object_write</field>
        <field name="update_path">expiration_date</field>
        <field name="evaluation_type">equation</field>
        <field name="value">record.create_date.date() + dateutil.relativedelta.relativedelta(months=12)</field>
    </record>

</odoo>
