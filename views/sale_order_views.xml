<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="loyalty_card_view_list_dialog" model="ir.ui.view">
        <field name="name">loyalty.card.view.list.dialog.dt.loyalty.points</field>
        <field name="model">loyalty.card</field>
        <field name="arch" type="xml">
            <list string="Available Coupons" create="false" edit="false" delete="false">
                <field name="code" string="Code" widget="CopyClipboardChar"/>
                <field name="points_display" string="Balance"/>
                <field name="expiration_date"/>
                <field name="program_id"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <record id="sale_order_view_form_inherit_points" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.dt.loyalty.points</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_available_coupons"
                    class="oe_stat_button"
                    type="object"
                    icon="fa-ticket"
                    groups="sales_team.group_sale_salesman"
                    invisible="available_coupon_count == 0"
                >
                    <field
                        string="Coupons"
                        name="available_coupon_count"
                        widget="statinfo"
                    />
                </button>
            </div>
        </field>
    </record>

</odoo>
